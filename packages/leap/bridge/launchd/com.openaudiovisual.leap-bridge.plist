<?xml version="1.0" encoding="UTF-8"?>
<!-- Template for install.sh: the __PLACEHOLDERS__ are filled in, the result goes to
     ~/Library/LaunchAgents/com.openaudiovisual.leap-bridge.plist. A per-user agent (not a daemon):
     it runs while you are logged in, which is when a browser can use it. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openaudiovisual.leap-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__BRIDGE__</string>
    <string>--port</string>
    <string>6437</string>__EXTRA_ARGS__
  </array>
  <key>WorkingDirectory</key>
  <string>__WORKDIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- if 6437 is taken the bridge exits; do not restart it more than every 10 s -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
