{
 "id": "novation-launchpad-pro-mk3",
 "short": "lppro3",
 "name": "Novation Launchpad Pro MK3",
 "maker": "Novation",
 "kind": "device",
 "channel": 1,
 "match": {
  "ports": [
   "lppromk3",
   "launchpad\\s*pro\\s*(\\[?mk\\s*3\\]?|3\\b)"
  ],
  "prefer": [
   "midi"
  ],
  "avoid": [
   "daw",
   "\\bdin\\b",
   "midiin[23]",
   "midiout[23]"
  ]
 },
 "sources": [
  {
   "title": "Launchpad Pro [MK3] Programmer's reference manual (Novation)",
   "url": "https://fael-downloads-prod.focusrite.com/customer/prod/s3fs-public/downloads/LPP3_prog_ref_guide_200415.pdf",
   "note": "official. 'Programmer mode layout' diagram (p.19): 8×8 pads = notes 11–88, 11 bottom-left, +1 to the right, +10 per row up; top row CC 91–98 (CC 90 top-left, CC 99 the logo); left column CC 80, 70 … 10 (top to bottom); right column CC 89, 79 … 19; the row under the grid CC 101–108, the row under that CC 1–8; 'all buttons and pads accept either Note or Control Change messages. The indicated type is which is sent by the device'. LEDs: note-on or CC on ch 1 = static, ch 2 = flashing, ch 3 = pulsing, velocity / value = palette index (0 off, 3 white, 5 red, 13 yellow, 21 green, 37 turquoise, 45 blue); Live/Programmer toggle F0 00 20 29 02 0E 0E <0|1> F7; three ports LPProMK3 MIDI / DIN / DAW"
  },
  {
   "title": "Launchpad Pro [MK3] User Guide v1 (Novation)",
   "url": "https://fael-downloads-prod.focusrite.com/customer/prod/s3fs-public/downloads/Launchpad%20Pro%20User%20Guide.pdf",
   "note": "official. §3 Hardware Overview (what is printed on each button: the top row ◀ ▶ Session Note Chord Custom Sequencer Projects, the left column ▲ ▼ Clear Duplicate Quantise Fixed Length Play Record, the right column Patterns … Print to Clip, the Ableton track controls Record Arm … Stop Clip); §10.4 pressure mode off / polyphonic / channel; §10.7 Programmer mode: hold Setup, press the orange Scene Launch button, release Setup; the unit always powers on into Live mode"
  }
 ],
 "notes": "Models Programmer mode, the one layout in which every pad and button has a documented message. Live mode (what the unit boots into) is different: Note, Chord, Custom and Session modes each send their own notes. Enter Programmer mode from the unit (hold Setup, press the orange Scene Launch button, release Setup) or with the programmer-mode message below. Use the first port, \"LPProMK3 MIDI\" (macOS), not DIN or DAW. The manual gives a channel only for lighting (ch 1 static, 2 flashing, 3 pulsing); channel 1 for what the pads and buttons send is an assumption (the worked examples are all channel 1), not a line of the manual: unconfirmed. Pads send velocity; their pressure (off, polyphonic or channel aftertouch) is a unit setting and is not modelled. The labels on the buttons are what the Live-mode faceplate prints; in Programmer mode they are only positions. CC 99 lights the logo and the Setup button sends nothing: both are drawn only. LED feedback: pads light turquoise (palette 37) while played, buttons white (palette 3).",
 "sysex": {
  "messages": [
   {
    "id": "device-inquiry",
    "purpose": "identity",
    "label": "Ask the unit who it is and which firmware it runs",
    "bytes": "F0 7E 7F 06 01 F7",
    "cite": {
     "source": 0,
     "where": "p. 6"
    }
   },
   {
    "id": "programmer-mode",
    "purpose": "mode",
    "label": "Enter Programmer mode, the one this file models",
    "bytes": "F0 00 20 29 02 0E 0E 01 F7",
    "undo": "live-mode",
    "cite": {
     "source": 0,
     "where": "p. 18"
    }
   },
   {
    "id": "live-mode",
    "purpose": "mode",
    "label": "Leave Programmer mode",
    "bytes": "F0 00 20 29 02 0E 0E 00 F7",
    "cite": {
     "source": 0,
     "where": "p. 18"
    }
   },
   {
    "id": "select-layout",
    "purpose": "mode",
    "label": "Select a layout and page",
    "bytes": "F0 00 20 29 02 0E 00 {layout} {page} 00 F7",
    "args": [
     {
      "name": "layout",
      "max": 19,
      "default": 17,
      "values": {
       "0": "Session (DAW mode only)",
       "1": "Fader",
       "2": "Chord",
       "3": "Custom Mode",
       "4": "Note / Drum",
       "17": "Programmer Mode",
       "18": "Settings Menu"
      }
     },
     {
      "name": "page",
      "max": 7,
      "default": 0
     }
    ],
    "cite": {
     "source": 0,
     "where": "p. 7"
    }
   },
   {
    "id": "daw-mode",
    "purpose": "mode",
    "label": "Enter DAW mode (Session and DAW Faders)",
    "bytes": "F0 00 20 29 02 0E 10 01 F7",
    "undo": "standalone-mode",
    "cite": {
     "source": 0,
     "where": "p. 14"
    }
   },
   {
    "id": "standalone-mode",
    "purpose": "mode",
    "label": "Leave DAW mode",
    "bytes": "F0 00 20 29 02 0E 10 00 F7",
    "cite": {
     "source": 0,
     "where": "p. 14"
    }
   },
   {
    "id": "led-static",
    "purpose": "led",
    "label": "Light one LED with a palette colour",
    "bytes": "F0 00 20 29 02 0E 03 00 {led} {color} F7",
    "args": [
     {
      "name": "led",
      "min": 1,
      "max": 108
     },
     {
      "name": "color",
      "label": "palette entry"
     }
    ],
    "cite": {
     "source": 0,
     "where": "p. 12"
    }
   },
   {
    "id": "led-flash",
    "purpose": "led",
    "label": "Flash one LED between two palette colours",
    "bytes": "F0 00 20 29 02 0E 03 01 {led} {colorB} {colorA} F7",
    "args": [
     {
      "name": "led",
      "min": 1,
      "max": 108
     },
     {
      "name": "colorB"
     },
     {
      "name": "colorA"
     }
    ],
    "cite": {
     "source": 0,
     "where": "p. 12"
    }
   },
   {
    "id": "led-pulse",
    "purpose": "led",
    "label": "Pulse one LED with a palette colour",
    "bytes": "F0 00 20 29 02 0E 03 02 {led} {pulse} F7",
    "args": [
     {
      "name": "led",
      "min": 1,
      "max": 108
     },
     {
      "name": "pulse",
      "label": "palette entry"
     }
    ],
    "cite": {
     "source": 0,
     "where": "p. 12"
    }
   },
   {
    "id": "led-rgb",
    "purpose": "led",
    "label": "Light one LED in any colour",
    "bytes": "F0 00 20 29 02 0E 03 03 {led} {r} {g} {b} F7",
    "args": [
     {
      "name": "led",
      "label": "LED address",
      "min": 1,
      "max": 108
     },
     {
      "name": "r",
      "max": 127
     },
     {
      "name": "g",
      "max": 127
     },
     {
      "name": "b",
      "max": 127
     }
    ],
    "cite": {
     "source": 0,
     "where": "p. 13"
    },
    "note": "Programmer mode only; the LED address is the Programmer-mode number."
   }
  ],
  "connect": [
   "programmer-mode"
  ]
 },
