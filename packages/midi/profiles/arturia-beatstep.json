{
 "id": "arturia-beatstep",
 "short": "beatstep",
 "name": "Arturia BeatStep",
 "maker": "Arturia",
 "kind": "device",
 "channel": 1,
 "match": {
  "ports": [
   "beatstep(?!\\s*pro)"
  ],
  "prefer": [],
  "avoid": [
