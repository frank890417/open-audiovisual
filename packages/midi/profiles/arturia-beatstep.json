{
 "id": "arturia-beatstep",
 "short": "beatstep",
 "name": "Arturia BeatStep",
 "maker": "Arturia",
 "kind": "device",
 "channel": 1,
 "match": {
  "ports": [
   "beatstep(?!\\s*pro)"
  ],
  "prefer": [],
  "avoid": [
   "pro"
  ]
 },
 "sources": [
  {
   "title": "BeatStep User's Manual v1.0.1 (Arturia)",
   "url": "https://downloads.arturia.com/products/beatstep/manual/BeatStep_Manual_1_0_1_EN.pdf",
   "note": "ch. 8 default settings (CNTRL presets): encoders 1–16 CC 7 74 71 76 77 93 73 75 114 18 19 16 17 91 79 72, Absolute, Global channel; pads 1–8 notes 44–51, pads 9–16 notes 36–43, Gate; STOP / PLAY send MMC Stop (01) / Play (02) to device 127. §3.1: Global MIDI channel defaults to 1. §2.2: 16 endless encoders + the Level/Rate encoder (master level in CNTRL mode), 16 velocity- and pressure-sensitive pads; pads numbered 1–8 on the top row, 9–16 below (front-panel diagram)"
  },
  {
   "title": "Ableton Live 12 MIDI Remote Script BeatStep (decompiled; non-official)",
   "url": "https://github.com/gluon/AbletonLive12_MIDIRemoteScripts/blob/main/BeatStep/BeatStep.py",
   "note": "same encoder CCs except encoder 1 (it re-programs the unit by SysEx and puts encoder 1 on CC 10); pad rows 44–51 (top) and 36–43 (bottom)"
  },
  {
   "title": "DrivenByMoss BeatstepControllerDefinition.java (Bitwig; non-official)",
   "url": "https://github.com/git-moss/DrivenByMoss/blob/master/src/main/java/de/mossgrabers/controller/arturia/beatstep/BeatstepControllerDefinition.java",
   "note": "port name \"Arturia BeatStep\""
  },
  {
   "title": "Ableton Live 12 MIDI Remote Script _Arturia/ArturiaControlSurface (decompiled; non-official)",
   "url": "https://github.com/gluon/AbletonLive12_MIDIRemoteScripts/blob/main/_Arturia/ArturiaControlSurface.py",
   "note": "setup messages F0 00 20 6B 7F 42 02 00 <property> <control> <value> F7; properties 1 mode, 2 channel, 3 identifier, 4 minimum, 5 maximum, 6 mode option, 16 colour. BeatStep.py gives the control addresses: encoders 32–47, pads 112–127, play 88, stop 89. Arturia publishes none of this."
  }
 ],
 "notes": "CNTRL mode (red pads) with the factory preset, Global channel 1. The big Level/Rate encoder is not modelled: the manual's default table does not list it (it \"controls the master level by default\"); if it also sends CC 7 it will move encoder 1 on screen. STOP / PLAY send MMC (the mmc-stop and mmc-play messages below) and are not modelled as controls. SEQ mode plays the step sequencer on the sequencer channel instead — not modelled. The encoders are endless but send absolute values in the default preset. Pad pressure: poly aftertouch is followed automatically if the unit sends it. The original BeatStep only — the BeatStep Pro is a different device and is not matched.",
 "sysex": {
  "messages": [
   {
    "id": "mmc-stop",
    "purpose": "transport",
    "dir": "in",
    "label": "The STOP button: MIDI Machine Control Stop",
    "bytes": "F0 7F 7F 06 01 F7",
    "cite": {
     "source": 0,
     "where": "p. 37"
    }
   },
   {
    "id": "mmc-play",
    "purpose": "transport",
    "dir": "in",
    "label": "The PLAY button: MIDI Machine Control Play",
    "bytes": "F0 7F 7F 06 02 F7",
    "cite": {
     "source": 0,
     "where": "p. 37"
    }
   },
   {
    "id": "write-parameter",
    "purpose": "config",
    "label": "Change one setting of one control in the working memory",
    "bytes": "F0 00 20 6B 7F 42 02 00 {property} {control} {value} F7",
    "args": [
     {
      "name": "property",
      "values": {
       "1": "mode",
       "2": "channel",
       "3": "identifier (CC or note)",
       "4": "minimum",
       "5": "maximum",
       "6": "mode option",
       "16": "colour"
      }
     },
     {
      "name": "control",
      "label": "encoders 32–47, pads 112–127, play 88, stop 89"
     },
     {
      "name": "value"
     }
    ],
    "cite": {
     "source": 3
    },
    "verified": false,
    "note": "This is how Ableton Live re-programs the unit. It changes what the controls send, so this file stops describing the unit until it is power-cycled."
   },
   {
    "id": "led-set",
    "purpose": "led",
    "label": "Set the colour of one pad",
    "bytes": "F0 00 20 6B 7F 42 02 00 10 {led} {color} F7",
    "args": [
     {
      "name": "led",
      "min": 112,
      "max": 127
     },
     {
      "name": "color"
     }
    ],
    "cite": {
     "source": 3
    },
    "verified": false,
    "note": "Colour values are not in the script; property 16 is named colour there."
   }
  ]
 },
