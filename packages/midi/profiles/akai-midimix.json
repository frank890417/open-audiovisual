{
 "id": "akai-midimix",
 "short": "midimix",
 "name": "AKAI MIDImix",
 "maker": "AKAI Professional",
 "kind": "device",
 "channel": 1,
 "match": {
  "ports": [
   "midi\\s*mix"
  ],
  "prefer": [],
  "avoid": []
 },
 "sources": [
  {
   "title": "MIDImix User Guide v1.0 (AKAI)",
   "url": "https://cdn.inmusicbrands.com/akai/attachments/MIDIMIX/MIDImix-UserGuide-v1.0.pdf",
   "note": "layout: 24 knobs (3 per channel), 8 mute buttons (amber-backlit; hold Solo to make them solo buttons), 8 record-arm buttons (red-backlit), 8 + 1 master faders, Bank Left / Right, Solo, Send All; Ableton Live control surface and port name \"MIDI Mix\"; 23.9 × 20.1 cm. It prints no MIDI numbers (the MIDImix Editor holds them)."
  },
  {
   "title": "Ableton Live 12 MIDI Remote Script MIDI_Mix (decompiled; non-official)",
   "url": "https://github.com/gluon/AbletonLive12_MIDIRemoteScripts/blob/main/MIDI_Mix/MIDI_Mix.py",
   "note": "all on channel 1: knob rows CC 16 20 24 28 46 50 54 58 / +1 / +2 (the bottom row is pan), faders CC 19 23 27 31 49 53 57 61, master CC 62; mute notes 1 4 … 22, solo (Solo held) 2 5 … 23, rec arm 3 6 … 24; bank left 25, bank right 26, solo 27; LEDs note-on 127 / 0"
  },
  {
   "title": "Ardour AKAI_MIDIMix_Normal_Mode.map and AKAI_MIDIMix_EQ_Mode.map (non-official)",
   "url": "https://github.com/Ardour/ardour/blob/master/share/midi_maps/AKAI_MIDIMix_Normal_Mode.map",
   "note": "agree with the Ableton script: faders 19 … 61, master 62, mute / solo / rec notes 1–24, bank 25 / 26, solo 27, knobs 16–18 … 58–60 (EQ map), channel 1"
  }
 ],
 "notes": "The factory mapping (what the MIDImix Editor calls the default), channel 1. AKAI's own documents print no numbers, so every number here comes from Ableton's shipped MIDI_Mix script and Ardour's maps, which agree. Holding Solo turns the Mute row into solo buttons sending notes 2, 5 … 23 — a layer the faceplate cannot show, so those notes are not modelled (they still arrive as midi/ch/1/note/<n>). Send All re-sends every knob and fader position and has no message of its own. LED feedback: mute (amber) and rec-arm (red) buttons, note-on 127 / 0, lit while held.",
 "face": {
  "w": 100,
  "h": 84,
  "label": "MIDImix",
  "body": "#1c1d20",
  "deco": [
   {
    "type": "buttons",
    "x": 83,
    "y": 6,
    "w": 13,
    "h": 4.5,
    "items": [
     "Send All"
    ]
   }
  ]
 },
