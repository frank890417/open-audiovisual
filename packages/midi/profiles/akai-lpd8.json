 "origin": {
  "tool": "TouchDesigner",
  "file": "AKAI_LPD8.tox",
  "note": "Che-Yu Wu's TouchDesigner tool: MIDI In (Device ID + Active toggle) → select ch10n* → Pad1–8, select ch1ctrl* → K1–K8, math 0..127 → 0..1, bound both ways to custom parameters (Pads page: 8 momentary pulses, Knobs page: 8 floats) and to an 800×200 panel (pads left, knobs right). TouchDesigner's MIDI In CHOP names channels 1-based (ch1ctrl75 = CC 74, ch10n37 = note 36); the numbers here are real MIDI numbers."
 },
 "sources": [
  {
   "title": "LPD8 mk2 User Guide v1.2 (AKAI)",
   "url": "https://cdn.inmusicbrands.com/akai/LPD8/LPD8%20mk2%20-%20User%20Guide%20-%20v1.2.pdf",
   "note": "4 programs, pad modes Note / Prog Chng / CC; no default numbers listed"
  },
  {
   "title": "AKAI_LPD8.tox (the artist's TouchDesigner tool)",
   "note": "pads arrive as notes on channel 10, knobs as CCs on channel 1 on his unit"
  },
  {
   "title": "Spectrasonics — Setting up the LPD8 mk2 (non-official)",
   "url": "https://support.spectrasonics.net/manual/Omnisphere3HW/3/en/topic/setting-up-the-lpd8-mk2",
   "note": "knobs CC 70–77 in program 1"
  },
  {
   "title": "AKAI support — LPD8 MKII: How to use 16 pads and knobs in MPC Beats",
   "url": "https://support.akaipro.com/en/support/solutions/articles/69000867977",
   "note": "pad notes 36–43 (as a setting, not stated as the default)"
  }
 ],
 "notes": "Pad note numbers are the common program-1 layout (36–43) but not printed in the manual — pads are marked unverified; 學習 rebinds them in one tap each. The pads light themselves; no LED feedback is sent.",
