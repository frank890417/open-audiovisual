{
 "id": "novation-launchpad-mini-mk3",
 "short": "lpmini",
 "name": "Novation Launchpad Mini MK3",
 "maker": "Novation",
 "kind": "device",
 "channel": 1,
 "match": {
  "ports": [
   "lpminimk3",
   "launchpad\\s*mini"
  ],
  "prefer": [
   "midi"
  ],
  "avoid": [
   "daw"
  ]
 },
 "origin": {
  "tool": "TouchDesigner",
  "file": "LaunchPadMini_251209.tox",
  "note": "Che-Yu Wu's TouchDesigner tool: MIDI In ch1 notes 36–99 in four groups of 16 (select1–4) = the four 4×4 drum racks; positions xy −4..−1 / 1..4 (skipping 0) or balanced −3.5..3.5; a stepped colour ramp gives each rack one colour (yellow, salmon red, lavender, green); idle pads drawn at ~16 % alpha, hit pads full colour with bloom; 'last event' (index + active) as the action output. TouchDesigner's MIDI In CHOP names channels 1-based (ch1ctrl75 = CC 74, ch10n37 = note 36); the numbers here are real MIDI numbers."
 },
 "sources": [
  {
   "title": "Launchpad Mini [MK3] Programmer's Reference Manual (Novation)",
   "url": "https://fael-downloads-prod.focusrite.com/customer/prod/s3fs-public/downloads/Launchpad%20Mini%20-%20Programmers%20Reference%20Manual.pdf",
   "note": "Drum Rack layout: lower-left 36–51, upper-left 52–67, lower-right 68–83, upper-right 84–99, rows bottom→top, left→right; top row CC 91–98; right column CC 89, 79 … 19; LED: note-on ch1 static (velocity = palette index), ch2 flash, ch3 pulse; palette 0 off, 3 white, 5 red, 13 yellow, 21 green, 45 blue, 49 purple; ports LPMiniMK3 MIDI / DAW"
  },
  {
   "title": "Launchpad Mini [MK3] User Guide (Novation)",
   "url": "https://fael-downloads-prod.focusrite.com/customer/prod/downloads/Launchpad%20Mini%20[Mk3]%20User%20Guide%20English.pdf",
   "note": "factory Custom 1 = Drum Rack, Custom 2 = Keys, Custom 3 = User (lighting)"
  },
  {
   "title": "LaunchPadMini_251209.tox (the artist's TouchDesigner tool)",
   "note": "grid on channel 1; a top-row button recorded as CC 95"
  },
  {
   "title": "QLC+ input profile Novation-LaunchPadMiniMK3.qxi (non-official)",
   "url": "https://github.com/mcallegari/qlcplus/blob/6ed78ed0a697aaa48b1428271e004b22327e5be3/resources/inputprofiles/Novation-LaunchPadMiniMK3.qxi",
   "note": "community profile by vidschofelix+Jan Fries; Apache-2.0; numbers read from QLC+ channel numbers, not checked by this project",
   "license": "Apache-2.0"
  }
 ],
 "notes": "Use the device in Custom mode 1 (Drums). Programmer mode (the programmer-mode message below) is a different layout: notes 11–88. What the right-column buttons send in Custom mode is undocumented (marked unverified; 學習 rebinds). LED colours are palette indices: the rack colours mirror the TD tool's ramp.",
 "sysex": {
  "messages": [
   {
    "id": "device-inquiry",
    "purpose": "identity",
    "label": "Ask the unit who it is and which firmware it runs",
    "bytes": "F0 7E 7F 06 01 F7",
    "cite": {
     "source": 0,
     "where": "p. 6"
    }
   },
   {
    "id": "select-layout",
    "purpose": "mode",
    "label": "Select a layout; the default is Custom mode 1, the one this file models",
    "bytes": "F0 00 20 29 02 0D 00 {layout} F7",
    "args": [
     {
      "name": "layout",
      "default": 4,
      "values": {
       "0": "Session (DAW mode only)",
       "4": "Custom mode 1 (Drum Rack)",
       "5": "Custom mode 2 (Keys)",
       "6": "Custom mode 3 (Lighting)",
       "13": "DAW Faders (DAW mode only)",
       "127": "Programmer mode"
      }
     }
    ],
    "cite": {
     "source": 0,
     "where": "p. 7"
    }
   },
   {
    "id": "programmer-mode",
    "purpose": "mode",
    "label": "Enter Programmer mode (notes 11–88, a different layout from this file)",
    "bytes": "F0 00 20 29 02 0D 0E 01 F7",
    "undo": "live-mode",
    "cite": {
     "source": 0,
     "where": "p. 7"
    }
   },
   {
    "id": "live-mode",
    "purpose": "mode",
    "label": "Leave Programmer mode",
    "bytes": "F0 00 20 29 02 0D 0E 00 F7",
    "cite": {
     "source": 0,
     "where": "p. 7"
    }
   },
   {
    "id": "daw-mode",
    "purpose": "mode",
    "label": "Enter DAW mode (Session and DAW Faders)",
    "bytes": "F0 00 20 29 02 0D 10 01 F7",
    "undo": "standalone-mode",
    "cite": {
     "source": 0,
     "where": "p. 15"
    }
   },
   {
    "id": "standalone-mode",
    "purpose": "mode",
    "label": "Leave DAW mode and clear its state",
    "bytes": "F0 00 20 29 02 0D 10 00 F7",
    "cite": {
     "source": 0,
     "where": "p. 15"
    }
   },
   {
    "id": "led-static",
    "purpose": "led",
    "label": "Light one LED with a palette colour",
    "bytes": "F0 00 20 29 02 0D 03 00 {led} {color} F7",
    "args": [
     {
      "name": "led",
      "min": 11,
      "max": 99
     },
     {
      "name": "color",
      "label": "palette entry"
     }
    ],
    "cite": {
     "source": 0,
     "where": "p. 14"
    }
   },
   {
    "id": "led-flash",
    "purpose": "led",
    "label": "Flash one LED between two palette colours",
    "bytes": "F0 00 20 29 02 0D 03 01 {led} {colorB} {colorA} F7",
    "args": [
     {
      "name": "led",
      "min": 11,
      "max": 99
     },
     {
      "name": "colorB"
     },
     {
      "name": "colorA"
     }
    ],
    "cite": {
     "source": 0,
     "where": "p. 14"
    }
   },
   {
    "id": "led-pulse",
    "purpose": "led",
    "label": "Pulse one LED with a palette colour",
    "bytes": "F0 00 20 29 02 0D 03 02 {led} {pulse} F7",
    "args": [
     {
      "name": "led",
      "min": 11,
      "max": 99
     },
     {
      "name": "pulse",
      "label": "palette entry"
     }
    ],
    "cite": {
     "source": 0,
     "where": "p. 14"
    }
   },
   {
    "id": "led-rgb",
    "purpose": "led",
    "label": "Light one LED in any colour",
    "bytes": "F0 00 20 29 02 0D 03 03 {led} {r} {g} {b} F7",
    "args": [
     {
      "name": "led",
      "label": "LED address",
      "min": 11,
      "max": 99
     },
     {
      "name": "r",
      "max": 127
     },
     {
      "name": "g",
      "max": 127
     },
     {
      "name": "b",
      "max": 127
     }
    ],
    "cite": {
     "source": 0,
     "where": "p. 14"
    },
    "note": "Works in Lighting Custom Modes and Programmer mode; the LED address is always the Programmer-mode number."
   },
   {
    "id": "brightness",
    "purpose": "config",
    "label": "Set the LED brightness",
    "bytes": "F0 00 20 29 02 0D 08 {level} F7",
    "args": [
     {
      "name": "level",
      "default": 127
     }
    ],
    "cite": {
     "source": 0,
     "where": "p. 22"
    }
   },
   {
    "id": "led-sleep",
    "purpose": "config",
    "label": "Turn every LED off (0) or back on (1)",
    "bytes": "F0 00 20 29 02 0D 09 {on} F7",
    "args": [
     {
      "name": "on",
      "max": 1,
      "default": 1
     }
    ],
    "cite": {
     "source": 0,
     "where": "p. 21"
    }
   }
  ],
