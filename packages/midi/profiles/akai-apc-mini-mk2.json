{
 "id": "akai-apc-mini-mk2",
 "short": "apcmini2",
 "name": "AKAI APC mini mk2",
 "maker": "AKAI Professional",
 "kind": "device",
 "channel": 1,
 "match": {
  "ports": [
   "apc\\s*mini\\s*(mk\\s*2|mkii)"
  ],
  "prefer": [
   "control"
  ],
  "avoid": [
   "notes",
   "midiin2"
  ]
 },
 "sources": [
  {
   "title": "APC mini mk2 Communications Protocol v1.0 (AKAI)",
   "url": "https://cdn.inmusicbrands.com/akai/attachments/APC%20mini%20mk2%20-%20Communication%20Protocol%20-%20v1.0.pdf",
   "note": "pad matrix diagram: notes 0x00–0x3F, 0x00 bottom-left, rows bottom→top, left→right; track buttons notes 0x64–0x6B (red LED), scene launch 0x70–0x77 (green LED), shift 0x7A (no LED), all channel 1 on port 0; faders 1–9 CC 0x30–0x38 channel 1, absolute; RGB LED = note-on where the channel sets behaviour (ch1–7 = 10/25/50/65/75/90/100 % brightness, ch8–11 pulse, ch12–16 blink) and velocity = palette index (0 #000000, 3 #FFFFFF, 5 #FF0000, 37 #00A9FF …); single LEDs = note-on ch1, velocity 0 off, 1 on, 2 blink"
  },
  {
   "title": "APC mini mk2 User Guide v1.7 (AKAI)",
   "url": "https://cdn.inmusicbrands.com/akai/apc-mini-mkii/APC%20mini%20mk2%20-%20User%20Guide%20-%20v1.7.pdf",
   "note": "faceplate legends (track row: Volume, Pan, Send, Device, ▲▼◀▶; scene column soft keys: Clip Stop, Solo, Mute, Rec Arm, Select, Drum, Note, Stop All Clips); Shift + scene 6 / 7 enters Drum / Note mode; 240 × 210 mm"
  },
  {
   "title": "Ableton Live 12 MIDI Remote Script APC_mini_mk2 (decompiled; non-official)",
   "url": "https://github.com/gluon/AbletonLive12_MIDIRemoteScripts/blob/main/APC_mini_mk2/elements.py",
   "note": "clip grid notes 0–63 on channel 1 (top row 56–63), drum-mode pads notes 64–127 on channel 10, track 100–107, scene 112–119, shift 122, faders CC 48–55, master CC 56; colors.py: FULL_BRIGHTNESS_CHANNEL = 6 (MIDI channel 7)"
  },
  {
   "title": "Ardour AKAI_APCmini_mk2.map (non-official)",
   "url": "https://github.com/Ardour/ardour/blob/master/share/midi_maps/AKAI_APCmini_mk2.map",
   "note": "faders CC 48–56, scene notes 112–119, grid notes 0–63, all channel 1"
  },
  {
   "title": "MPC_Mapper README (non-official)",
   "url": "https://github.com/miles-p/MPC_Mapper",
   "note": "the port that carries pads, buttons, faders and LEDs is named \"APC mini mk2 … Control\" (Linux)"
  }
 ],
 "notes": "Session (clip-launch) layout, the one the unit boots into: the 8×8 grid sends notes 0–63 on channel 1, bottom-left = 0. Drum mode (Shift + scene 6: notes 64–127 on channel 10) and Note mode (Shift + scene 7: notes on the second USB port) are not modelled — 學習 can rebind. Shift (note 122) is a plain button the host reads; the printed Shift legends are host functions. The unit has two USB ports: the first (…Control on Linux, plain \"APC mini mk2\" on Windows) carries everything here; the second carries Note mode only. LED feedback: grid pads lit at 100 % brightness (channel 7) with palette 37 (#00A9FF) while held; track buttons (red) and scene buttons (green) are single-colour, velocity 1 = on.",
 "face": {
  "w": 100,
  "h": 87.5,
  "label": "APC mini mk2",
  "body": "#1a1a1c"
 },
