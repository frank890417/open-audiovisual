{
  "name": "open-audiovisual",
  "version": "0.1.0",
  "description": "A web-native framework for audiovisual performance: input (MIDI · audio · chords · pose) → mapping → algorithmic worlds → output, with a timeline and a backstage monitor.",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "start": "node serve.js",
    "monitor": "node packages/monitor/server.js",
    "bridge": "node packages/osc/bridges/osc-bridge.js",
    "test": "node --test tests/*.test.js"
  },
  "repository": { "type": "git", "url": "https://github.com/frank890417/open-audiovisual.git" },
  "keywords": ["audiovisual", "performance", "midi", "webmidi", "creative-coding", "vj", "generative-art", "osc", "mediapipe", "timeline", "show-control"],
  "author": "Che-Yu Wu (吳哲宇)",
  "license": "MIT"
}
